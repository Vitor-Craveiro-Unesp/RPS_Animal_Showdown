# Development defaults only. Never use these placeholder values in production.
APP_ENV=development

# Local PostgreSQL container
POSTGRES_DB=rps_animal_showdown
POSTGRES_USER=rps_app
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=55432

# Backend API — DATABASE_URL must use the SQLAlchemy psycopg form.
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://rps_app:local-development-only@postgres:5432/rps_animal_showdown
ALLOWED_ORIGINS=http://localhost:3000
# Local placeholder only. Generate a distinct 32+ byte value per environment.
REALTIME_TICKET_SIGNING_KEY=local-development-realtime-ticket-key-replace-before-deploy

# Frontend local container. In Vercel, this is the public HTTPS Render URL;
# production builds fail closed if it is missing or does not use HTTPS.
FRONTEND_PORT=3000
API_INTERNAL_BASE_URL=http://backend:8000
# Public websocket endpoint only; it is not a credential.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8000/v1/realtime

# Organizer access is issued per tournament by the backend as an opaque
# capability token. Never configure a fixed organizer token in environment
# variables or expose a capability through NEXT_PUBLIC_* variables.
